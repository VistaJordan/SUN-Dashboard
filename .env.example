# Copy these into the Vercel project: Settings -> Environment Variables (Production).
# Never commit real values. BLOB_READ_WRITE_TOKEN is added for you when you connect a Blob store.

# Entra app registration -> Overview -> Application (client) ID
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Directory (tenant) IDs whose accounts may sign in, comma-separated.
# Option A (recommended): only the Seamless FM tenant, with Sun Holdings contacts invited as B2B guests.
# Option B: the Seamless FM tenant plus the Sun Holdings tenant (requires a multi-tenant app registration).
ENTRA_TENANT_IDS=00000000-0000-0000-0000-000000000000

# Who can edit (upload data, post updates, change settings). Emails or @domains, comma-separated.
# EXAMPLE values: replace with the real Seamless FM addresses/domain.
PORTAL_ADMINS=samh@byblosvista.com,@seamlessfm.com

# Who can view (read-only). Emails or @domains, comma-separated. Admins can always view.
# EXAMPLE value: replace with the real Sun Holdings addresses/domain (listing individual emails is safest).
PORTAL_VIEWERS=first.last@sunholdings-example.com

# Added automatically by the Vercel Blob integration
BLOB_READ_WRITE_TOKEN=
