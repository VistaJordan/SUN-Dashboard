# Copy these into the Vercel project: Settings -> Environment Variables (Production).
# Never commit real values. BLOB_READ_WRITE_TOKEN is added for you when you connect a Blob store.

# The Seamless FM admin code. Staff enter it once (top bar -> "Seamless FM sign-in") to unlock
# uploading trackers, posting updates, adding notes and changing settings. Without it the portal is read-only.
PORTAL_ADMIN_KEY=choose-a-long-code

# Optional. If set, viewers (SUN Holdings) must enter this code once before they can see the portal.
# Leave empty and anyone with the link can view.
PORTAL_VIEW_KEY=

# Added automatically by the Vercel Blob integration
BLOB_READ_WRITE_TOKEN=
